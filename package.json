{
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:design-tokens": "vitest run src/test/design-tokens.test.ts",
    "test:components": "vitest run src/components/ui/__tests__",
    "test:utils": "vitest run src/lib/__tests__",
    "typecheck": "tsc --noEmit",
    "db:generate": "cross-env NODE_OPTIONS=--experimental-require-module prisma generate",
    "db:push": "cross-env NODE_OPTIONS=--experimental-require-module prisma db push",
    "db:migrate": "cross-env NODE_OPTIONS=--experimental-require-module prisma migrate dev",
    "db:seed": "cross-env NODE_OPTIONS=--experimental-require-module prisma db seed",
    "db:studio": "cross-env NODE_OPTIONS=--experimental-require-module prisma studio",
    "postinstall": "cross-env NODE_OPTIONS=--experimental-require-module prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-neon": "^7.9.0",
    "@neondatabase/serverless": "^1.1.0",
